# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap admin (server-only). The first sign-in with these credentials
# creates the user in Supabase and grants the admin role.
# Use a strong password; remove these once you have your own admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
